# CODION v1.0: the six competency queries of the publication (Section 8).
# Run against CODION-v1.0.ttl plus a populated graph, e.g. CODION-v1.0-test-graph.ttl.
# Queries are separated by lines starting with "#### Q".

#### Q1 Coordinated behaviour across content and actors (8.1)
PREFIX codion: <https://ontology.cogops.eu/codion#>
SELECT ?c1 ?c2 ?actor1 ?actor2
WHERE {
  ?c1 codion:coordinatedWith ?c2 ;
      codion:hasAuthor ?actor1 .
  ?c2 codion:hasAuthor ?actor2 .

  ?a1 codion:assessedActor ?actor1 ;
      codion:actorAssessmentMetric "CoordinatedBehaviour" ;
      codion:actorAssessmentValue ?s1 .
  ?a2 codion:assessedActor ?actor2 ;
      codion:actorAssessmentMetric "CoordinatedBehaviour" ;
      codion:actorAssessmentValue ?s2 .

  FILTER(?s1 > 0.7 && ?s2 > 0.7 && ?actor1 != ?actor2)
}

#### Q2 Targeting institutions and decision processes (8.2)
PREFIX codion: <https://ontology.cogops.eu/codion#>
SELECT ?campaign ?target ?role ?confidence
WHERE {
  ?tr a codion:TargetingRelation ;
      codion:targetingSource ?campaign ;
      codion:targetedEntity ?target ;
      codion:targetRole ?role ;
      codion:targetingConfidence ?confidence .

  FILTER(?role = "InstitutionalTarget" ||
         ?role = "DecisionProcessTarget")
}
ORDER BY DESC(?confidence)

#### Q3 Operational role versus measured network position (8.3)
PREFIX codion: <https://ontology.cogops.eu/codion#>
SELECT ?actor ?assignedRole ?measuredRole
WHERE {
  ?participation codion:participatingActor ?actor ;
                 codion:participationRole ?assignedRole .

  ?actor codion:actorHasNetworkPosition ?netpos .
  ?netpos codion:networkPositionRole ?measuredRole .

  FILTER(?assignedRole != "Amplifier" &&
         ?measuredRole = "Amplifier")
}

#### Q4 Vulnerability-to-harm pathway (8.4)
PREFIX codion: <https://ontology.cogops.eu/codion#>
SELECT ?vuln ?effect ?outcome ?impact ?harm ?subcat
WHERE {
  ?vuln codion:vulnerabilityContributesToEffect ?effect .
  ?effect codion:immediateEffectLeadsToOutcome ?outcome .
  ?outcome codion:outcomeManifestsAsImpact ?impact .
  ?impact codion:impactEscalatesToHarm ?harm .
  ?harm codion:harmSubCategory ?subcat .
}

#### Q5 Context-specific topic exploitability (8.5)
PREFIX codion: <https://ontology.cogops.eu/codion#>
SELECT ?topic ?location ?score ?confidence
WHERE {
  ?assessment a codion:TopicAssessment ;
     codion:assessedTopic ?topic ;
     codion:assessmentContextLocation ?location ;
     codion:topicExploitabilityScore ?score ;
     codion:topicAssessmentConfidence ?confidence .

  FILTER(?score > 0.7)
}
ORDER BY DESC(?score)

#### Q6 Audience progression from intended to affected (8.6)
PREFIX codion: <https://ontology.cogops.eu/codion#>
SELECT ?campaign ?audienceType ?relType ?confidence
WHERE {
  ?campaign codion:audienceRelationshipInstance ?rel .

  ?rel codion:audienceRelationshipType ?relType ;
       codion:audienceRelationshipStageOrder ?stage ;
       codion:audienceRelationshipConfidence ?confidence ;
       codion:relationshipInvolvesAudience ?aud .

  ?aud codion:audienceType ?audienceType .
}
ORDER BY ?stage
