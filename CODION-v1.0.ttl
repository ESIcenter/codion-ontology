codion:networkPositionNetwork a owl:DatatypeProperty ;
    rdfs:label "network identifier" ;
    rdfs:comment "Identifies which network the position was measured in (e.g. 'Telegram coordination network, Feb 2026')." ;
    rdfs:domain codion:NetworkPositionAssertion ;
    rdfs:range xsd:string .

codion:networkPositionRole a owl:DatatypeProperty ;
    rdfs:label "network position role" ;
    rdfs:comment "Controlled vocabulary: Hub | Bridge | Broker | SourceNode | Gatekeeper | PeripheralNode | Authority | Amplifier | SuperSpreader." ;
    rdfs:domain codion:NetworkPositionAssertion ;
    rdfs:range xsd:string .

codion:networkPositionSubject a owl:ObjectProperty ;
    rdfs:label "network position subject" ;
    rdfs:comment "Typically an Actor, but may also be a ContentItem or Channel for content-propagation network analysis." ;
    rdfs:domain codion:NetworkPositionAssertion ;
    rdfs:range codion:CogOpsEntity .

codion:networkPositionValue a owl:DatatypeProperty ;
    rdfs:label "metric value" ;
    rdfs:domain codion:NetworkPositionAssertion ;
    rdfs:range xsd:float .

codion:outgroupHostilityScore a owl:DatatypeProperty ;
    rdfs:label "outgroup hostility score" ;
    rdfs:comment "Score [0,1] for explicit hostility toward a defined out-group." ;
    rdfs:domain codion:RhetoricalAnnotation ;
    rdfs:range xsd:float .

codion:overallPolarity a owl:DatatypeProperty ;
    rdfs:label "overall polarity" ;
    rdfs:comment "Controlled vocabulary: POSITIVE | NEGATIVE | NEUTRAL | MIXED." ;
    rdfs:domain codion:SentimentAnnotation ;
    rdfs:range xsd:string .

codion:polarityScore a owl:DatatypeProperty ;
    rdfs:label "polarity score" ;
    rdfs:comment "Continuous sentiment score normalised to [-1, +1]." ;
    rdfs:domain codion:SentimentAnnotation ;
    rdfs:range xsd:float .

codion:rhetoricIntensity a owl:DatatypeProperty ;
    rdfs:label "rhetoric intensity" ;
    rdfs:domain codion:RhetoricalAnnotation ;
    rdfs:range xsd:float .

codion:sadnessScore a owl:DatatypeProperty ;
    rdfs:label "sadness score" ;
    rdfs:domain codion:EmotionAnnotation ;
