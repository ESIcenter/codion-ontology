    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

codion:countermeasureId a owl:DatatypeProperty ;
    rdfs:label "countermeasure ID" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

codion:countermeasureImplementationCost a owl:DatatypeProperty ;
    rdfs:label "implementation cost" ;
    rdfs:comment "Controlled vocabulary: LOW | MEDIUM | HIGH | VERY_HIGH." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

codion:countermeasureImplementedBy a owl:ObjectProperty ;
    rdfs:label "implemented by" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range codion:Actor .

codion:countermeasureIsDeployable a owl:DatatypeProperty ;
    rdfs:label "is currently deployable" ;
    rdfs:comment "False for theoretical or future countermeasures not yet operationally available." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:boolean .

codion:countermeasureMitigatesTactic a owl:ObjectProperty ;
    rdfs:label "mitigates DISARM tactic" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range disarm:Tactic .

codion:countermeasureMitigatesTechnique a owl:ObjectProperty ;
    rdfs:label "mitigates DISARM technique" ;
    rdfs:comment "The DISARM Red technique(s) this countermeasure is designed to address." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range disarm:Technique .

codion:countermeasureName a owl:DatatypeProperty ;
    rdfs:label "countermeasure name" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

codion:countermeasurePrecedes a owl:ObjectProperty ;
    rdfs:label "countermeasure precedes" ;
    rdfs:comment "Recommended sequencing: this countermeasure should be applied before the target (e.g., Detection before Disruption)." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range codion:Countermeasure .

codion:countermeasureRecommendsForTopic a owl:ObjectProperty ;
    rdfs:label "recommended for topic" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range codion:Topic .

codion:countermeasureReducesImpact a owl:ObjectProperty ;
