codion:incidentStartDate a owl:DatatypeProperty ;
    rdfs:label "incident start date" ;
    rdfs:domain codion:Incident ;
    rdfs:range xsd:dateTime .

codion:incidentStixId a owl:DatatypeProperty ;
    rdfs:label "STIX ID" ;
    rdfs:comment "STIX 2.1 IntrusionSet object ID for cross-platform exchange." ;
    rdfs:domain codion:Incident ;
    rdfs:range xsd:string .

codion:incidentTargetCountry a owl:DatatypeProperty ;
    rdfs:label "target country" ;
    rdfs:domain codion:Incident ;
    rdfs:range xsd:string .

codion:incidentTargetsAudience a owl:ObjectProperty ;
    rdfs:label "incident targets audience" ;
    rdfs:domain codion:Incident ;
    rdfs:range codion:AudienceSegment .

codion:incidentTargetsLocation a owl:ObjectProperty ;
    rdfs:label "incident targets location" ;
    rdfs:domain codion:Incident ;
    rdfs:range codion:Location .

codion:incidentType a owl:DatatypeProperty ;
    rdfs:label "incident type" ;
    rdfs:comment "Controlled vocabulary: COORDINATED_INAUTHENTIC_BEHAVIOUR | NARRATIVE_INJECTION | ASTROTURFING | HACK_AND_LEAK | IMPERSONATION | PLATFORM_MANIPULATION | DEEPFAKE_CAMPAIGN." ;
    rdfs:domain codion:Incident ;
    rdfs:range xsd:string .

codion:infraHostedIn a owl:ObjectProperty ;
    rdfs:label "infrastructure hosted in" ;
    rdfs:comment "The geographic location (country/jurisdiction) where the physical infrastructure is hosted." ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range codion:Location .

codion:infraId a owl:DatatypeProperty ;
    rdfs:label "infrastructure ID" ;
    rdfs:domain codion:Infrastructure ;
