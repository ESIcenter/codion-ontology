codion:similarityEmbeddingModel a owl:DatatypeProperty ;
    rdfs:label "embedding model" ;
    rdfs:domain codion:SimilarityRelation ;
    rdfs:range xsd:string .

codion:similarityScore a owl:DatatypeProperty ;
    rdfs:label "similarity score" ;
    rdfs:comment "Cosine similarity or other metric [0,1] between the two content items." ;
    rdfs:domain codion:SimilarityRelation ;
    rdfs:range xsd:float .

codion:similaritySourceItem a owl:ObjectProperty ;
    rdfs:label "source item" ;
    rdfs:domain codion:SimilarityRelation ;
    rdfs:range codion:ContentItem .

codion:similarityTargetItem a owl:ObjectProperty ;
    rdfs:label "target item" ;
    rdfs:domain codion:SimilarityRelation ;
    rdfs:range codion:ContentItem .

codion:similarityType a owl:DatatypeProperty ;
    rdfs:label "similarity type" ;
    rdfs:comment "Controlled vocabulary: TEXTUAL | TOPICAL | SEMANTIC | STRUCTURAL | NARRATIVE | COORDINATED." ;
    rdfs:domain codion:SimilarityRelation ;
    rdfs:range xsd:string .

codion:subjectivityScore a owl:DatatypeProperty ;
    rdfs:label "subjectivity score" ;
    rdfs:comment "Score [0,1] for degree of opinion vs. fact." ;
    rdfs:domain codion:SentimentAnnotation ;
    rdfs:range xsd:float .

codion:supportedByEvidence a owl:ObjectProperty ;
    rdfs:label "supported by evidence" ;
    rdfs:domain codion:Assertion ;
    rdfs:range codion:Evidence .

codion:surpriseScore a owl:DatatypeProperty ;
    rdfs:label "surprise score" ;
    rdfs:domain codion:EmotionAnnotation ;
    rdfs:range xsd:float .

codion:targetsSentimentToward a owl:ObjectProperty ;
    rdfs:label "targets sentiment toward" ;
    rdfs:comment "The entity (person, organisation) toward whom the expressed sentiment is directed." ;
    rdfs:domain codion:AffectiveProfile ;
    rdfs:range codion:Actor .

codion:topicAssessedAt a owl:DatatypeProperty ;
    rdfs:label "assessed at" ;
    rdfs:domain codion:TopicAssessment ;
    rdfs:range xsd:dateTime .

codion:topicAssessmentConfidence a owl:DatatypeProperty ;
    rdfs:label "assessment confidence" ;
    rdfs:domain codion:TopicAssessment ;
    rdfs:range xsd:float .

codion:topicAssessmentMethod a owl:DatatypeProperty ;
    rdfs:label "assessment method" ;
    rdfs:domain codion:TopicAssessment ;
    rdfs:range xsd:string .

codion:topicExploitabilityScore a owl:DatatypeProperty ;
    rdfs:label "exploitability score (contextual)" ;
    rdfs:comment "[0,1], scoped to the assessment's context (location/audience/event/time)." ;
    rdfs:domain codion:TopicAssessment ;
    rdfs:range xsd:float .

codion:topicPolarizationIndex a owl:DatatypeProperty ;
    rdfs:label "polarization index (contextual)" ;
    rdfs:domain codion:TopicAssessment ;
    rdfs:range xsd:float .

codion:toxicityScore a owl:DatatypeProperty ;
    rdfs:label "toxicity score" ;
    rdfs:comment "Perspective API-style toxicity score [0,1]." ;
    rdfs:domain codion:RhetoricalAnnotation ;
    rdfs:range xsd:float .

codion:trustScore a owl:DatatypeProperty ;
    rdfs:label "trust score" ;
