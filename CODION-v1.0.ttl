codion:campaignStartDate a owl:DatatypeProperty ;
    rdfs:label "start date" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:dateTime .

codion:campaignTargetsAudience a owl:ObjectProperty ;
    rdfs:label "campaign targets audience" ;
    rdfs:comment "Shorthand direct link (use AudienceRelationship for typed, evidenced relations)." ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:AudienceSegment .

codion:campaignTargetsLocation a owl:ObjectProperty ;
    rdfs:label "campaign targets location" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Location .

codion:campaignTriggeredDetection a owl:ObjectProperty ;
    rdfs:label "campaign triggered detection" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:DetectionEvent .

codion:campaignType a owl:DatatypeProperty ;
    rdfs:label "campaign type" ;
    rdfs:comment "Controlled vocabulary: DISINFORMATION | PROPAGANDA | INFLUENCE_OP | ASTROTURFING | HACK_AND_LEAK | COGNITIVE_WARFARE | PERCEPTION_MANAGEMENT." ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:campaignUsesTactic a owl:ObjectProperty ;
    rdfs:label "campaign uses tactic" ;
    rdfs:comment "A Campaign employs this DISARM Red Tactic." ;
    rdfs:domain codion:Campaign ;
    rdfs:range disarm:Tactic .

codion:campaignUsesTechnique a owl:ObjectProperty ;
    rdfs:label "campaign uses technique" ;
    rdfs:comment "A Campaign employs this DISARM Red Technique or Sub-Technique." ;
    rdfs:domain codion:Campaign ;
    rdfs:range disarm:Technique .

codion:detectedAt a owl:DatatypeProperty ;
    rdfs:label "detected at" ;
    rdfs:domain codion:Campaign ;
