    rdfs:comment "Two actors or actor profiles share compatible motivational drivers — basis for coalition or coordination inference." ;
    rdfs:domain codion:Motivation ;
    rdfs:range codion:Motivation .

codion:motivationConfidence a owl:DatatypeProperty ;
    rdfs:label "attribution confidence" ;
    rdfs:comment "[0,1] analyst confidence in this motivation attribution." ;
    rdfs:domain codion:Motivation ;
    rdfs:range xsd:float .

codion:motivationConflictsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "motivation conflicts with" ;
    rdfs:domain codion:Motivation ;
    rdfs:range codion:Motivation .

codion:motivationDescription a owl:DatatypeProperty ;
    rdfs:label "motivation description" ;
    rdfs:domain codion:Motivation ;
    rdfs:range xsd:string .

codion:motivationEvidence a owl:DatatypeProperty ;
    rdfs:label "supporting evidence" ;
    rdfs:comment "Observable evidence or indicators supporting this motivation attribution." ;
    rdfs:domain codion:Motivation ;
    rdfs:range xsd:string .

codion:motivationId a owl:DatatypeProperty ;
    rdfs:label "motivation ID" ;
    rdfs:domain codion:Motivation ;
    rdfs:range xsd:string .

codion:motivationIsPrimary a owl:DatatypeProperty ;
    rdfs:label "is primary motivation" ;
    rdfs:comment "True if this is the primary (most important) motivation driving the actor." ;
    rdfs:domain codion:Motivation ;
    rdfs:range xsd:boolean .

codion:motivationLabel a owl:DatatypeProperty ;
    rdfs:label "motivation label" ;
    rdfs:domain codion:Motivation ;
    rdfs:range xsd:string .

codion:motivationStixVocabValue a owl:DatatypeProperty ;
    rdfs:label "STIX 2.1 motivation vocabulary value" ;
    rdfs:comment "Corresponding STIX 2.1 open vocabulary value for ThreatActor motivation field (e.g., 'dominance', 'ideology', 'organizational-gain')." ;
    rdfs:domain codion:Motivation ;
    rdfs:range xsd:string .

codion:motivationType a owl:DatatypeProperty ;
    rdfs:label "motivation type" ;
    rdfs:domain codion:Motivation ;
    rdfs:range xsd:string .

codion:numberOfActorsInvolved a owl:DatatypeProperty ;
    rdfs:label "number of actors involved" ;
    rdfs:domain codion:Campaign ;
