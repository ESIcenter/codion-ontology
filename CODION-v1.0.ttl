codion:infraRegisteredAt a owl:DatatypeProperty ;
    rdfs:label "registered at" ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range xsd:dateTime .

codion:infraRegistrantCountry a owl:DatatypeProperty ;
    rdfs:label "registrant country" ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range xsd:string .

codion:infraRegistrar a owl:DatatypeProperty ;
    rdfs:label "registrar" ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range xsd:string .

codion:infraType a owl:DatatypeProperty ;
    rdfs:label "infrastructure type" ;
    rdfs:comment "Controlled vocabulary: DOMAIN | IP_ADDRESS | HOSTING_PROVIDER | CDN | VPN | TOR_EXIT | API_KEY | BOTNET | SOCIAL_ACCOUNT_NETWORK." ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range xsd:string .

codion:infraValue a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:comment "The actual domain name, IP address, or other identifier." ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range xsd:string .

codion:isOngoing a owl:DatatypeProperty ;
    rdfs:label "is ongoing" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:boolean .

codion:motivationAlignsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
