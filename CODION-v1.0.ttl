    rdfs:domain codion:Event ;
    rdfs:range codion:Event .

codion:eventId a owl:DatatypeProperty ;
    rdfs:label "event ID" ;
    rdfs:domain codion:Event ;
    rdfs:range xsd:string .

codion:eventLocationGeo a owl:DatatypeProperty ;
    rdfs:label "location geo" ;
    rdfs:comment "WKT POINT or GeoJSON string." ;
    rdfs:domain codion:Event ;
    rdfs:range xsd:string .

codion:eventLocationName a owl:DatatypeProperty ;
    rdfs:label "location name" ;
    rdfs:domain codion:Event ;
    rdfs:range xsd:string .

codion:eventName a owl:DatatypeProperty ;
    rdfs:label "event name" ;
    rdfs:domain codion:Event ;
    rdfs:range xsd:string .

codion:eventOccurredAt a owl:ObjectProperty ;
    rdfs:label "event occurred at" ;
    rdfs:domain codion:Event ;
    rdfs:range codion:Location .

codion:eventSalience a owl:DatatypeProperty ;
