    rdfs:range xsd:boolean .

codion:isOngoingEvent a owl:DatatypeProperty ;
    rdfs:label "is ongoing" ;
    rdfs:domain codion:Event ;
    rdfs:range xsd:boolean .

codion:isoCountryCode a owl:DatatypeProperty ;
    rdfs:label "ISO country code" ;
    rdfs:comment "ISO 3166-1 alpha-2 code (applicable to CountryLocation instances)." ;
