codion:estimatedReach a owl:DatatypeProperty ;
    rdfs:label "estimated reach" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:integer .

codion:exploitsEvent a owl:ObjectProperty ;
    rdfs:label "exploits event" ;
    rdfs:comment "The campaign uses this event as a pretext or catalyst for its narratives." ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Event .

codion:fundedBy a owl:ObjectProperty ;
    rdfs:label "funded by" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Actor .

codion:hasActivity a owl:ObjectProperty ;
    rdfs:label "has activity" ;
    rdfs:comment "A campaign comprises activities." ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Activity .

codion:hostingProvider a owl:DatatypeProperty ;
