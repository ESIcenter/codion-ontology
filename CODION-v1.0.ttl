    rdfs:domain codion:Impact ;
    rdfs:range xsd:string .

codion:impactMagnitude a owl:DatatypeProperty ;
    rdfs:label "impact magnitude" ;
    rdfs:comment "[0,1] normalised severity of the impact." ;
    rdfs:domain codion:Impact ;
    rdfs:range xsd:float .

