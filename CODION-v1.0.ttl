codion:incidentProducedImpact a owl:ObjectProperty ;
    rdfs:label "incident produced impact" ;
    rdfs:domain codion:Incident ;
    rdfs:range codion:Impact .

codion:incidentServesObjective a owl:ObjectProperty ;
