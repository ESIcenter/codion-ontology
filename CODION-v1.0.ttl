    rdfs:comment "Explicit alignment link to a DISARM Blue catalogue entry." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range disarm:Counter .

codion:countermeasureScalability a owl:DatatypeProperty ;
    rdfs:label "scalability" ;
    rdfs:comment "Controlled vocabulary: INDIVIDUAL | LOCAL | NATIONAL | REGIONAL | GLOBAL." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

codion:countermeasureSideEffectRisk a owl:DatatypeProperty ;
    rdfs:label "side effect risk" ;
    rdfs:comment "Description of potential unintended consequences: overblocking, chilling effect on free speech, legitimacy costs, Streisand effect." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

codion:countermeasureTargetsAudience a owl:ObjectProperty ;
    rdfs:label "countermeasure targets audience" ;
