    rdfs:domain codion:Campaign ;
    rdfs:range codion:Vulnerability .

codion:campaignFollowsProcedure a owl:ObjectProperty ;
    rdfs:label "campaign follows procedure" ;
    rdfs:comment "A Campaign matches a known DISARM Procedure (TTP combination fingerprint)." ;
    rdfs:domain codion:Campaign ;
    rdfs:range disarm:Procedure .

codion:campaignHasTargetingRelation a owl:ObjectProperty ;
    rdfs:label "campaign has targeting relation" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:TargetingRelation .

codion:campaignId a owl:DatatypeProperty ;
    rdfs:label "campaign ID" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:campaignName a owl:DatatypeProperty ;
    rdfs:label "campaign name" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:campaignObjectives a owl:DatatypeProperty ;
    rdfs:label "objectives" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:campaignProducedEffect a owl:ObjectProperty ;
    rdfs:label "campaign produced effect" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Effect .

codion:campaignProducedImpact a owl:ObjectProperty ;
    rdfs:label "campaign produced impact" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Impact .

codion:campaignPursuesObjective a owl:ObjectProperty ;
    rdfs:label "campaign pursues objective" ;
    rdfs:domain codion:Campaign ;
