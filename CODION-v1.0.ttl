    rdfs:domain codion:Incident ;
    rdfs:range disarm:Technique .

codion:incidentId a owl:DatatypeProperty ;
    rdfs:label "incident ID" ;
    rdfs:domain codion:Incident ;
    rdfs:range xsd:string .

codion:incidentInvolvedContent a owl:ObjectProperty ;
    rdfs:label "incident involved content" ;
    rdfs:domain codion:Incident ;
    rdfs:range codion:ContentItem .

codion:incidentPartOfCampaign a owl:ObjectProperty ;
    rdfs:label "incident part of campaign" ;
