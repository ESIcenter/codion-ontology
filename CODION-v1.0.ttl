    rdfs:label "activity ID" ;
    rdfs:domain codion:Activity ;
    rdfs:range xsd:string .

codion:activityName a owl:DatatypeProperty ;
    rdfs:label "activity name" ;
    rdfs:domain codion:Activity ;
    rdfs:range xsd:string .

codion:activityPartOfCampaign a owl:ObjectProperty ;
    rdfs:label "activity part of campaign" ;
    rdfs:domain codion:Activity ;
    rdfs:range codion:Campaign ;
    owl:inverseOf codion:hasActivity .

codion:activityPursuesObjective a owl:ObjectProperty ;
    rdfs:label "activity pursues objective" ;
    rdfs:domain codion:Activity ;
    rdfs:range codion:Objective .

codion:activityStartTime a owl:DatatypeProperty ;
    rdfs:label "activity start time" ;
    rdfs:domain codion:Activity ;
    rdfs:range xsd:dateTime .

codion:asnNumber a owl:DatatypeProperty ;
    rdfs:label "ASN number" ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range xsd:string .

codion:attributedTo a owl:DatatypeProperty ;
    rdfs:label "attributed to" ;
    rdfs:comment "Free-text attribution label (e.g. 'GRU', 'Internet Research Agency')." ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:attributionConfidence a owl:DatatypeProperty ;
    rdfs:label "attribution confidence" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:float .

codion:audienceRelationshipInstance a owl:ObjectProperty ;
    rdfs:label "has audience relationship" ;
    rdfs:comment "Links a Campaign to a reified AudienceRelationship instance." ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:AudienceRelationship .

codion:campaignDrivenByMotivation a owl:ObjectProperty ;
    rdfs:label "campaign driven by motivation" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Motivation .

codion:campaignEndDate a owl:DatatypeProperty ;
    rdfs:label "end date" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:dateTime .

codion:campaignExploitsVulnerability a owl:ObjectProperty ;
