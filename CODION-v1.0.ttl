    rdfs:domain codion:Event ;
    rdfs:range xsd:float .

codion:eventSentimentVolatility a owl:DatatypeProperty ;
    rdfs:label "event sentiment volatility" ;
    rdfs:comment "Degree [0,1] to which public sentiment is unstable around this event — high volatility amplifies disinformation effectiveness." ;
    rdfs:domain codion:Event ;
    rdfs:range xsd:float .

codion:eventStartDate a owl:DatatypeProperty ;
    rdfs:label "event start date" ;
    rdfs:domain codion:Event ;
    rdfs:range xsd:dateTime .

codion:eventTriggeredIncident a owl:ObjectProperty ;
    rdfs:label "event triggered incident" ;
    rdfs:comment "The FIMI/disinformation incident that this event precipitated or was used to justify." ;
    rdfs:domain codion:Event ;
    rdfs:range codion:Incident .

codion:eventType a owl:DatatypeProperty ;
    rdfs:label "event type" ;
    rdfs:comment "e.g. ELECTION | MILITARY_CONFLICT | NATURAL_DISASTER | POLITICAL_CRISIS | HEALTH_EMERGENCY | SPORTING_EVENT." ;
    rdfs:domain codion:Event ;
    rdfs:range xsd:string .

