# ===========================================================================
#  DISARM v1.6 alignment (disarm: namespace)
# ===========================================================================

disarm:Counter a owl:Class ;
    rdfs:label "DISARM Counter" ;
    rdfs:comment "A DISARM Blue countermeasure. The DISARM master data defines 140 countermeasures; CODION includes a representative subset of 10 as named individuals." ;
    rdfs:subClassOf disarm:DISARMEntity .

disarm:DISARMEntity a owl:Class ;
    rdfs:label "DISARM Entity" ;
    rdfs:comment "Root class for all DISARM framework objects." .

disarm:Phase a owl:Class ;
    rdfs:label "DISARM Phase" ;
    rdfs:comment """Highest-level grouping in DISARM. Phases group Tactics into
broad campaign stages: Planning, Preparation, Execute, and Assess.""" ;
    rdfs:subClassOf disarm:DISARMEntity .

disarm:Procedure a owl:Class ;
    rdfs:label "DISARM Procedure" ;
    rdfs:comment """A specific combination of Techniques observed in a real incident,
forming a threat-actor fingerprint.""" ;
    rdfs:subClassOf disarm:DISARMEntity .

disarm:SubTechnique a owl:Class ;
    rdfs:label "DISARM Sub-Technique" ;
    rdfs:comment "A specific implementation of a parent Technique. DISARM v1.6 defines 288 sub-techniques; CODION includes a representative subset of 12. IDs follow the format T-code.NNN (e.g. T0023.002)." ;
    rdfs:subClassOf disarm:Technique .

disarm:Tactic a owl:Class ;
    rdfs:label "DISARM Tactic" ;
    rdfs:comment """Tactical objective — the 'why' of a stage in an influence
operation. 16 tactics in DISARM Red v1.6 (TA01–TA16).""" ;
    rdfs:subClassOf disarm:DISARMEntity .

disarm:Technique a owl:Class ;
    rdfs:label "DISARM Technique" ;
    rdfs:comment "A specific action that achieves a Tactic. DISARM v1.6 defines 103 techniques; CODION includes a representative subset of 76 as named individuals. IDs follow the T-code format (e.g. T0002)." ;
    rdfs:subClassOf disarm:DISARMEntity,
        codion:ManipulationTechnique .

disarm:belongsToPhase a owl:ObjectProperty ;
    rdfs:label "belongs to phase" ;
    rdfs:domain disarm:Tactic ;
    rdfs:range disarm:Phase .

disarm:belongsToTactic a owl:ObjectProperty ;
    rdfs:label "belongs to tactic" ;
    rdfs:comment "Links a Technique (or Sub-Technique) to its parent Tactic." ;
    rdfs:domain disarm:Technique ;
    rdfs:range disarm:Tactic .

disarm:counterActorType a owl:DatatypeProperty ;
    rdfs:label "counter actor type" ;
    rdfs:comment "Who implements this counter: PLATFORM | GOVERNMENT | CIVIL_SOCIETY | RESEARCHER | INDIVIDUAL." ;
    rdfs:domain disarm:Counter ;
    rdfs:range xsd:string .

disarm:counterType a owl:DatatypeProperty ;
    rdfs:label "counter type" ;
    rdfs:comment "DISARM Blue counter category (e.g. DETECT | DISRUPT | DENY | DEGRADE | DECEIVE | DETER)." ;
    rdfs:domain disarm:Counter ;
    rdfs:range xsd:string .

disarm:description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:detectionIndicators a owl:DatatypeProperty ;
    rdfs:label "detection indicators" ;
    rdfs:comment "Observable signals that this technique is being used; semicolon-separated." ;
    rdfs:domain disarm:Technique ;
    rdfs:range xsd:string .

disarm:disarmId a owl:DatatypeProperty ;
    rdfs:label "DISARM ID" ;
    rdfs:comment "DISARM framework identifier (e.g. 'TA02', 'T0023', 'T0023.002', 'C00001')." ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:disarmVersion a owl:DatatypeProperty ;
    rdfs:label "DISARM version" ;
    rdfs:comment "Version of the DISARM framework this entity belongs to (e.g. '1.6')." ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:exampleIncidents a owl:DatatypeProperty ;
    rdfs:label "example incidents" ;
    rdfs:comment "Semicolon-separated list of known incident names where this technique was observed." ;
    rdfs:domain disarm:Technique ;
    rdfs:range xsd:string .

disarm:isSubTechnique a owl:DatatypeProperty ;
    rdfs:label "is sub-technique" ;
    rdfs:domain disarm:Technique ;
    rdfs:range xsd:boolean .

disarm:killChainPhase a owl:DatatypeProperty ;
    rdfs:label "kill chain phase" ;
    rdfs:comment "DISARM kill-chain phase name (e.g. 'plan-objectives', 'develop-content')." ;
    rdfs:domain disarm:Technique ;
    rdfs:range xsd:string .

disarm:mitigatedBy a owl:ObjectProperty ;
    rdfs:label "mitigated by" ;
    rdfs:comment "A Technique is mitigated by one or more Blue Team Counters." ;
    rdfs:domain disarm:Technique ;
    rdfs:range disarm:Counter .

disarm:name a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:procedureUsesTechnique a owl:ObjectProperty ;
    rdfs:label "procedure uses technique" ;
    rdfs:domain disarm:Procedure ;
    rdfs:range disarm:Technique .

disarm:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "source URL" ;
    rdfs:comment "Canonical URL for this entity in the DISARMFoundation GitHub." ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:anyURI .

disarm:stixId a owl:DatatypeProperty ;
    rdfs:label "STIX ID" ;
    rdfs:comment "Full STIX 2.1 object ID from the DISARM STIX bundle (e.g. 'attack-pattern--8ab240c2-...')." ;
    rdfs:domain disarm:DISARMEntity ;
    rdfs:range xsd:string .

disarm:subTechniqueOf a owl:ObjectProperty ;
    rdfs:label "sub-technique of" ;
    rdfs:comment "Links a Sub-Technique to its parent Technique." ;
    rdfs:domain disarm:SubTechnique ;
    rdfs:range disarm:Technique .

disarm:tacticallyPrecedes a owl:ObjectProperty ;
    rdfs:label "tactically precedes" ;
    rdfs:comment "Typical ordering in a kill chain: this Tactic precedes the target in campaign progression." ;
    rdfs:domain disarm:Tactic ;
    rdfs:range disarm:Tactic .

disarm:techniqueEnables a owl:ObjectProperty ;
    rdfs:label "technique enables" ;
    rdfs:comment "Use of this technique commonly enables or amplifies the target technique." ;
    rdfs:domain disarm:Technique ;
    rdfs:range disarm:Technique .

disarm:C00001 a disarm:Counter ;
    rdfs:label "C00001 Prebunking" ;
    disarm:counterActorType "CIVIL_SOCIETY" ;
    disarm:counterType "DENY" ;
    disarm:description "Proactively expose audiences to weakened forms of misleading arguments to build psychological resistance." ;
    disarm:disarmId "C00001" ;
    disarm:mitigatedBy disarm:C00001 ;
    disarm:name "Prebunking" .

disarm:C00002 a disarm:Counter ;
