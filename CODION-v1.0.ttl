    rdfs:range xsd:string .

codion:countermeasureType a owl:DatatypeProperty ;
    rdfs:label "countermeasure type" ;
    rdfs:comment "Controlled vocabulary: DETECTION | DISRUPTION | DENIAL | DEGRADATION | NARRATIVE | LEGAL | TECHNICAL | EDUCATION." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

