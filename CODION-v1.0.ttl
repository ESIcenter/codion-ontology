codion:numberOfChannelsUsed a owl:DatatypeProperty ;
    rdfs:label "number of channels used" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:integer .

codion:objectiveAchieved a owl:DatatypeProperty ;
    rdfs:label "objective achieved" ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:boolean .

codion:objectiveAchievedAsImpact a owl:ObjectProperty ;
    rdfs:label "objective achieved as impact" ;
    rdfs:comment "Links an Objective to the Impact that constitutes evidence of its achievement." ;
    rdfs:domain codion:Objective ;
    rdfs:range codion:Impact .

codion:objectiveAchievementIndicators a owl:DatatypeProperty ;
    rdfs:label "achievement indicators" ;
    rdfs:comment "Observable signals that this objective has been achieved (survey results, election outcome, etc.)." ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:string .

codion:objectiveConfidence a owl:DatatypeProperty ;
    rdfs:label "attribution confidence" ;
    rdfs:comment "[0,1] analyst confidence in the objective attribution." ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:float .

codion:objectiveConflictsWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "objective conflicts with" ;
    rdfs:comment "For actors with competing objectives (e.g., economic gain vs. plausible deniability)." ;
    rdfs:domain codion:Objective ;
    rdfs:range codion:Objective .

codion:objectiveDescription a owl:DatatypeProperty ;
    rdfs:label "objective description" ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:string .

codion:objectiveId a owl:DatatypeProperty ;
    rdfs:label "objective ID" ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:string .

codion:objectiveLabel a owl:DatatypeProperty ;
    rdfs:label "objective label" ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:string .

codion:objectiveMappedToTactic a owl:ObjectProperty ;
    rdfs:label "objective mapped to tactic" ;
    rdfs:comment "The DISARM tactic that operationally implements this objective." ;
    rdfs:domain codion:Objective ;
    rdfs:range disarm:Tactic .

codion:objectivePriorityRank a owl:DatatypeProperty ;
    rdfs:label "priority rank" ;
    rdfs:comment "Relative priority of this objective within a campaign (1 = highest priority)." ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:integer .

codion:objectiveSupports a owl:ObjectProperty ;
    rdfs:label "objective supports" ;
    rdfs:comment "Hierarchical objective decomposition — achieving this sub-objective contributes to the parent objective." ;
    rdfs:domain codion:Objective ;
    rdfs:range codion:Objective .

codion:objectiveTargetsAudience a owl:ObjectProperty ;
    rdfs:label "objective targets audience" ;
    rdfs:domain codion:Objective ;
    rdfs:range codion:AudienceSegment .

codion:objectiveTargetsLocation a owl:ObjectProperty ;
    rdfs:label "objective targets location" ;
    rdfs:domain codion:Objective ;
    rdfs:range codion:Location .

codion:objectiveTimeframe a owl:DatatypeProperty ;
    rdfs:label "timeframe" ;
    rdfs:comment "Controlled vocabulary: SHORT_TERM | MEDIUM_TERM | LONG_TERM." ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:string .

codion:objectiveType a owl:DatatypeProperty ;
    rdfs:label "objective type" ;
    rdfs:domain codion:Objective ;
    rdfs:range xsd:string .

codion:operatedByInfraOperator a owl:ObjectProperty ;
    rdfs:label "operated by" ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range codion:Actor .

codion:patternAnomalyScore a owl:DatatypeProperty ;
    rdfs:label "anomaly score" ;
    rdfs:domain codion:TemporalPattern ;
    rdfs:range xsd:float .

codion:patternEndAt a owl:DatatypeProperty ;
    rdfs:label "pattern end" ;
    rdfs:domain codion:TemporalPattern ;
    rdfs:range xsd:dateTime .

codion:patternPeakHourUTC a owl:DatatypeProperty ;
    rdfs:label "peak hour (UTC)" ;
    rdfs:domain codion:TemporalPattern ;
    rdfs:range xsd:integer .

codion:patternRecurrenceInterval a owl:DatatypeProperty ;
    rdfs:label "recurrence interval" ;
    rdfs:domain codion:TemporalPattern ;
    rdfs:range xsd:duration .

codion:patternStartAt a owl:DatatypeProperty ;
    rdfs:label "pattern start" ;
    rdfs:domain codion:TemporalPattern ;
    rdfs:range xsd:dateTime .

codion:patternType a owl:DatatypeProperty ;
    rdfs:label "pattern type" ;
    rdfs:comment "e.g. SURGE | SCHEDULED | REACTIVE | COORDINATED_BURST | DORMANCY." ;
    rdfs:domain codion:TemporalPattern ;
    rdfs:range xsd:string .

codion:registeredWith a owl:ObjectProperty ;
    rdfs:label "registered with" ;
    rdfs:comment "A domain registered with a specific registrar (both are Infrastructure instances)." ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range codion:Infrastructure .

codion:sharesInfrastructureWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "shares infrastructure with" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Campaign .

codion:sophisticationLevel a owl:DatatypeProperty ;
    rdfs:label "sophistication level" ;
    rdfs:comment "Controlled vocabulary: LOW | MEDIUM | HIGH | APT." ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:tacticsObserved a owl:DatatypeProperty ;
    rdfs:label "tactics observed" ;
    rdfs:comment "Semicolon-separated list of DISARM/AMITT tactic codes observed." ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:targetCountry a owl:DatatypeProperty ;
    rdfs:label "target country" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:targetDemographic a owl:DatatypeProperty ;
    rdfs:label "target demographic" ;
    rdfs:domain codion:Campaign ;
    rdfs:range xsd:string .

codion:techniqueDescription a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:domain codion:ManipulationTechnique ;
    rdfs:range xsd:string .

codion:techniqueFramework a owl:DatatypeProperty ;
    rdfs:label "framework" ;
    rdfs:comment "Reference framework: DISARM | AMITT | FIMI | CUSTOM." ;
    rdfs:domain codion:ManipulationTechnique ;
    rdfs:range xsd:string .

codion:techniqueId a owl:DatatypeProperty ;
    rdfs:label "technique ID" ;
    rdfs:comment "DISARM or AMITT framework identifier (e.g. 'T0023')." ;
    rdfs:domain codion:ManipulationTechnique ;
    rdfs:range xsd:string .

codion:techniqueName a owl:DatatypeProperty ;
    rdfs:label "technique name" ;
    rdfs:domain codion:ManipulationTechnique ;
    rdfs:range xsd:string .

codion:techniqueTacticPhase a owl:DatatypeProperty ;
    rdfs:label "tactic phase" ;
    rdfs:comment "Phase in the influence operation kill chain." ;
    rdfs:domain codion:ManipulationTechnique ;
    rdfs:range xsd:string .

codion:temporalPatternId a owl:DatatypeProperty ;
    rdfs:label "temporal pattern ID" ;
    rdfs:domain codion:TemporalPattern ;
    rdfs:range xsd:string .

codion:tlpClassification a owl:DatatypeProperty ;
    rdfs:label "TLP classification" ;
    rdfs:comment "Traffic Light Protocol: WHITE | GREEN | AMBER | RED." ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range xsd:string .

codion:usesChannel a owl:ObjectProperty ;
    rdfs:label "uses channel" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Channel .

codion:usesInfrastructure a owl:ObjectProperty ;
    rdfs:label "uses infrastructure" ;
    rdfs:domain codion:Campaign ;
    rdfs:range codion:Infrastructure .

codion:usesTechnique a owl:ObjectProperty ;
    rdfs:label "uses technique" ;
    rdfs:comment "The technique(s) an activity employs. DISARM techniques are valid values because disarm:Technique is a subclass of ManipulationTechnique." ;
    rdfs:domain codion:Activity ;
    rdfs:range codion:ManipulationTechnique .

codion:whoisPrivacy a owl:DatatypeProperty ;
    rdfs:label "WHOIS privacy enabled" ;
    rdfs:domain codion:Infrastructure ;
    rdfs:range xsd:boolean .

# ===========================================================================
#  Module D - Consequences and Response
# ===========================================================================

codion:AccountCompromise a owl:Class ;
    rdfs:label "Account Compromise" ;
    rdfs:comment """A security vulnerability in which legitimate high-follower accounts can be
acquired through credential theft, phishing, or purchase, enabling disinformation
dissemination with the credibility of established identities.
Maps directly to DISARM T0091 (Obtain Compromised Account).
Corresponds to Actor.isSockpuppetConfirmed = true on the compromised account.""" ;
    rdfs:subClassOf codion:TechnicalVulnerability .

codion:AlgorithmicAmplification a owl:Class ;
    rdfs:label "Algorithmic Amplification" ;
    rdfs:comment """A platform characteristic where recommendation algorithms preferentially
surface emotionally activating, sensational, or engagement-maximising content,
inadvertently amplifying disinformation beyond organic reach. Corresponds to
Channel.algorithmicAmplification = true and Channel.channelHasRecommendationAlgorithm = true.
Distinct from the DISARM technique T0056 (Purchase Targeted Advertisements):
AlgorithmicAmplification is a structural platform vulnerability, not an actor technique.""" ;
    rdfs:subClassOf codion:TechnicalVulnerability .

codion:ArmedConflict a owl:Class ;
    rdfs:label "Armed Conflict Vulnerability" ;
    rdfs:comment """Heightened susceptibility during active armed conflict or military crisis.
Armed conflict produces information chaos, reduced verification capacity, high fear
and uncertainty, degraded media infrastructure, and strong demand for real-time
information — all conditions that disinformation exploits.
Corresponds to MilitaryConflictEvent and Objective.MilitaryObjective.
Maps to DISARM T0066 (Conduct Symbolic Action) for conflict-period operations.""" ;
    rdfs:subClassOf codion:SituationalVulnerability .

codion:AttitudinalImpact a owl:Class ;
    rdfs:label "Attitudinal Impact" ;
    rdfs:comment "Changes in attitudes or preferences toward persons, institutions, groups, or policies." ;
    rdfs:subClassOf codion:Impact .

codion:AuthorityBias a owl:Class ;
    rdfs:label "Authority Bias" ;
    rdfs:comment """The tendency to attribute greater accuracy and credibility to the opinions
of an authority figure. Disinformation exploiting authority bias uses fake experts
(T0018), impersonation (T0028), and borrowed institutional credibility (T0016).
Source: Cialdini 1984 social influence model.""" ;
    rdfs:subClassOf codion:CognitiveVulnerability .

codion:AvailabilityBias a owl:Class ;
    rdfs:label "Availability Bias" ;
    rdfs:comment """The tendency to overestimate the likelihood or importance of events that are
easily recalled, typically because they are vivid, recent, or emotionally salient.
Disinformation exploits availability bias through high-frequency repetition (T0049
Flood Information Space) and emotionally charged content (T0021 Memes).""" ;
    rdfs:subClassOf codion:CognitiveVulnerability .

codion:BehaviouralImpact a owl:Class ;
    rdfs:label "Behavioural Impact" ;
    rdfs:comment "Observable changes in behaviour — voting patterns, protest participation, purchasing, avoidance, violence." ;
    rdfs:subClassOf codion:Impact .

codion:CognitiveImpact a owl:Class ;
    rdfs:label "Cognitive Impact" ;
    rdfs:comment "Changes in individual or collective beliefs, knowledge states, or information processing heuristics." ;
    rdfs:subClassOf codion:Impact .

codion:CognitiveOverload a owl:Class ;
    rdfs:label "Cognitive Overload" ;
    rdfs:comment """The state in which an individual's working memory capacity is overwhelmed
by the volume, velocity, or complexity of information, reducing their capacity for
critical evaluation. Disinformation deliberately induces cognitive overload through
information flooding (T0049), information pollution (T0063), and rapid narrative
cycling. High-information-volume media environments structurally produce this state.""" ;
    rdfs:subClassOf codion:CognitiveVulnerability .

codion:CognitiveVulnerability a owl:Class ;
    rdfs:label "Cognitive Vulnerability" ;
    rdfs:comment """Individual psychological predispositions that make a person more susceptible
to accepting, sharing, or acting on disinformation. These are not deficits or
pathologies but normal features of human cognition that disinformation is designed
to exploit. Maps to DISARM T0010 (Conduct Psychographic Analysis) and the
psychological mechanisms described in Lewandowsky et al. 2017.""" ;
    rdfs:subClassOf codion:Vulnerability .

codion:ConfirmationBias a owl:Class ;
    rdfs:label "Confirmation Bias" ;
    rdfs:comment """The tendency to search for, interpret, favour, and recall information that
confirms or supports one's prior beliefs. Disinformation exploiting confirmation bias
frames false claims to align with existing worldviews, reducing critical scrutiny.
Maps to DISARM T0003 (Leverage Existing Narratives).""" ;
    rdfs:subClassOf codion:CognitiveVulnerability .

codion:Countermeasure a owl:Class ;
    rdfs:label "Countermeasure" ;
    rdfs:comment "Any detection, disruption, denial, degradation, mitigation or recovery action taken in response to a cognitive operation. Aligned with DISARM Blue through disarmCounterId and with NIST CSF 2.0 through nistCSFFunction." ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

codion:DegradationCountermeasure a owl:Class ;
    rdfs:label "Degradation Countermeasure" ;
    rdfs:comment "Reduce the effectiveness of the operation without fully stopping it (labelling, friction, demotion in feeds)." ;
    rdfs:subClassOf codion:Countermeasure .

codion:DenialCountermeasure a owl:Class ;
    rdfs:label "Denial Countermeasure" ;
    rdfs:comment "Prevent the narrative from reaching its intended audience (takedown, deplatforming, content removal)." ;
    rdfs:subClassOf codion:Countermeasure .

codion:DetectionCountermeasure a owl:Class ;
    rdfs:label "Detection Countermeasure" ;
    rdfs:comment "Identify, monitor, and alert on disinformation activity. Maps to NIST CSF DETECT function." ;
    rdfs:subClassOf codion:Countermeasure .

codion:DetectionEvent a owl:Class ;
    rdfs:label "Detection Event" ;
    rdfs:comment "A system-generated alert or analyst finding flagging suspicious activity." ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

codion:DisruptionCountermeasure a owl:Class ;
    rdfs:label "Disruption Countermeasure" ;
    rdfs:comment "Actively impede the operational capability of a disinformation campaign. Maps to NIST CSF RESPOND." ;
    rdfs:subClassOf codion:Countermeasure .

codion:EconomicCrisis a owl:Class ;
    rdfs:label "Economic Crisis Vulnerability" ;
    rdfs:comment """Heightened susceptibility during periods of economic shock, recession,
hyperinflation, financial crisis, or severe inequality. Economic crises amplify
social grievances, erode institutional trust, create scapegoating dynamics,
and produce receptivity to simple causal narratives.
Corresponds to EconomicEvent and Motivation.EconomicMotivation (of adversaries
who exploit the crisis) and SocialVulnerability.SocialGrievance (of affected audiences).
Maps to DISARM T0074 (Identify Existing Fissures) in economic contexts.""" ;
    rdfs:subClassOf codion:SituationalVulnerability .

codion:EconomicImpact a owl:Class ;
    rdfs:label "Economic Impact" ;
    rdfs:comment "Measurable financial consequences: market movements, reduced investment, currency devaluation, consumer behaviour changes." ;
    rdfs:subClassOf codion:Impact .

codion:EducationCountermeasure a owl:Class ;
    rdfs:label "Education Countermeasure" ;
    rdfs:comment "Media literacy programmes, prebunking curricula, digital resilience training. Longest-term but most durable countermeasure category." ;
    rdfs:subClassOf codion:Countermeasure .

codion:Effect a owl:Class ;
    rdfs:label "Effect" ;
    rdfs:comment """A measured or inferred impact of a disinformation operation on a target
audience. Covers the 'E' (Effect) and 'D' (Degree) dimensions of the ABCDE
framework. Includes belief change, polarisation amplification, institutional
trust erosion, and mobilisation to offline action.""" ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

codion:ElectionPeriod a owl:Class ;
    rdfs:label "Election Period Vulnerability" ;
    rdfs:comment """Heightened susceptibility during electoral campaigns and voting periods.
Election periods produce elevated emotional salience, intense political polarisation,
high-volume information environments, and strong motivation for both domestic and
foreign adversaries to interfere. The EEAS FIMI framework identifies elections as
the single most frequently exploited situational context.
Corresponds to ElectoralEvent and Objective.ElectoralObjective.""" ;
    rdfs:subClassOf codion:SituationalVulnerability .

codion:EmotionalReasoning a owl:Class ;
    rdfs:label "Emotional Reasoning" ;
    rdfs:comment """The tendency to treat one's emotional response to information as evidence for
its truth — 'it feels true, therefore it is true'. Disinformation specifically targets
this vulnerability through high-arousal emotional content (anger, fear, disgust),
corresponding to elevated EmotionAnnotation.angerScore, fearScore and disgustScore.""" ;
    rdfs:subClassOf codion:CognitiveVulnerability .

codion:Harm a owl:Class ;
    rdfs:label "Harm" ;
    rdfs:comment """Subclass of Effect capturing legally and ethically framed harm
outcomes. Carries additional legal category, severity, and DSA regulatory
reporting fields. Maps directly to the AMAS DEMEAN/DEFRAUD/DISINFORM harm
typology and to Wardle & Derakhshan's information disorder harm model.""" ;
    rdfs:subClassOf codion:Effect .

codion:IdentityConflict a owl:Class ;
    rdfs:label "Identity Conflict" ;
    rdfs:comment """A condition in which identity-defining attributes (national, ethnic, religious,
linguistic, or political) are in active tension or contested within or between
communities. Identity conflict activates Haidt MFT loyalty and sanctity foundations,
making communities susceptible to in-group/out-group disinformation framing.
Maps to DISARM T0083 (Identify Target Audience Adversaries) and InGroupBias.""" ;
    rdfs:subClassOf codion:SocialVulnerability .

codion:ImmediateEffect a owl:Class ;
    rdfs:label "Immediate Effect" ;
    rdfs:comment "The first-order, directly observable effect close to exposure (e.g. '12% of exposed users reported believing Claim X'). First stage of the Effect causal chain: ImmediateEffect -> Outcome -> Impact -> Harm." ;
    rdfs:subClassOf codion:Effect .

codion:Impact a owl:Class ;
    rdfs:label "Impact" ;
    rdfs:comment """Measured or estimated consequence of a disinformation operation on its
target system, with explicit measurement methodology and confidence bounds.
Distinct from Effect (broader, including unintended and unmeasured outcomes):
Impact specifically tracks observed, attributable changes.
Implements causal inference requirements for disinformation impact research.
Integrates AMAS three-part harm taxonomy (DEMEAN/DEFRAUD/DISINFORM).""" ;
    rdfs:subClassOf codion:Effect ;
    codion:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

codion:InGroupBias a owl:Class ;
    rdfs:label "In-Group Bias" ;
    rdfs:comment """The tendency to favour information sourced from or about one's own social,
ethnic, political, or ideological in-group. Disinformation exploiting in-group bias
frames narratives in terms of in-group/out-group conflict, activating loyalty and
authority moral foundations (Haidt MFT). Maps to DISARM T0082 (Identify Wedge Issues)
and T0083 (Identify Target Audience Adversaries).""" ;
    rdfs:subClassOf codion:CognitiveVulnerability .

codion:InformationIsolation a owl:Class ;
    rdfs:label "Information Isolation" ;
    rdfs:comment """A condition in which a community has limited access to diverse, high-quality
information sources — either due to geographic isolation, language barriers,
media ownership concentration, or deliberate censorship. Information isolation
creates data voids (T0080) that disinformation fills.
Corresponds to AudienceSegment.audienceTrustInMainstreamMedia (low) and
Location.locationPressFreedomIndex (low).""" ;
    rdfs:subClassOf codion:SocialVulnerability .

codion:InstitutionalImpact a owl:Class ;
    rdfs:label "Institutional Impact" ;
    rdfs:comment "Measurable change in trust in or perceived legitimacy of institutions (government, media, science, judiciary)." ;
    rdfs:subClassOf codion:Impact .

codion:LegalCountermeasure a owl:Class ;
    rdfs:label "Legal Countermeasure" ;
    rdfs:comment "Regulatory enforcement, judicial action, sanctions, or law enforcement response." ;
    rdfs:subClassOf codion:Countermeasure .

codion:LowInstitutionalTrust a owl:Class ;
    rdfs:label "Low Institutional Trust" ;
    rdfs:comment """A condition in which a significant portion of a community has low confidence
in mainstream institutions — government, media, scientific bodies, judiciary.
Low institutional trust creates receptivity to alternative information sources
and reduces the effectiveness of authoritative corrections and fact-checks.
Maps to DISARM T0069 (Discredit Credible Sources) and Impact.InstitutionalImpact.""" ;
    rdfs:subClassOf codion:SocialVulnerability .

codion:MediaEcosystemImpact a owl:Class ;
    rdfs:label "Media Ecosystem Impact" ;
    rdfs:comment "Changes in media consumption patterns, trust in journalism, or the information environment structure." ;
    rdfs:subClassOf codion:Impact .

codion:MissingProvenance a owl:Class ;
    rdfs:label "Missing Content Provenance" ;
    rdfs:comment """A technical gap in which digital content lacks verifiable origin,
creation timestamp, or chain-of-custody metadata, making it impossible to verify
authenticity or detect manipulation. Addressed by the ITU/ISO/IEC AMAS initiative and
the C2PA content credentials specification. Per ETSI TR 104 159 clause 7.2.2, C2PA and
ISCC provenance signals have documented limitations: they are not universally
implemented (some model providers deliberately omit them), can be stripped by bad
actors, are weakened by routine re-encoding/compression, and their widespread adoption
risks the 'liar's dividend' phenomenon — genuine content being wrongly dismissed as
fake because it lacks provenance metadata, or a person in an authentic but unflattering
recording dishonestly claiming it is synthetic. Corresponds to
ContentItem.contentHash absence and unreliable syntheticContentScore. Exploited by
deepfake campaigns (T0085, T0086).""",
        """A technical gap in which digital content lacks verifiable origin, creation
timestamp, or chain-of-custody metadata, making it impossible to verify authenticity
or detect manipulation. Addressed by the ITU/ISO/IEC AMAS initiative and the C2PA
content credentials specification.
Corresponds to ContentItem.contentHash absence and ContentItem.syntheticContentScore
being unavailable or unreliable. Exploited by deepfake campaigns (T0085, T0086).""" ;
    rdfs:subClassOf codion:TechnicalVulnerability .

codion:NarrativeCountermeasure a owl:Class ;
    rdfs:label "Narrative Countermeasure" ;
    rdfs:comment "Strategic communication, prebunking, debunking, or counter-narrative campaigns. Maps to NIST CSF PROTECT." ;
    rdfs:subClassOf codion:Countermeasure .

codion:NaturalDisaster a owl:Class ;
    rdfs:label "Natural Disaster Vulnerability" ;
    rdfs:comment """Heightened susceptibility immediately before, during, and after natural
disasters (earthquakes, floods, wildfires, storms). Natural disasters disrupt
information infrastructure, displace populations, overwhelm official communications,
and create acute information voids that disinformation fills with attribution
narratives (blame assignment), resource misallocation claims, and panic amplification.
Corresponds to NaturalDisasterEvent.""" ;
    rdfs:subClassOf codion:SituationalVulnerability .

codion:NegativityBias a owl:Class ;
    rdfs:label "Negativity Bias" ;
    rdfs:comment """The tendency to give more attention, weight, and processing resources to
negative information than equivalent positive information. Disinformation exploits
negativity bias through fear appeals (fearAppealScore), threat framing, and
catastrophising. Maps to EmotionAnnotation.fearScore and RhetoricalAnnotation.urgencyScore.""" ;
    rdfs:subClassOf codion:CognitiveVulnerability .

codion:Outcome a owl:Class ;
    rdfs:label "Outcome" ;
    rdfs:comment "An intermediate consequence following from an ImmediateEffect (e.g. 'trust in institution X fell by 4 points among the exposed population'). Second stage of the Effect causal chain." ;
    rdfs:subClassOf codion:Effect .

codion:Polarization a owl:Class ;
    rdfs:label "Societal Polarization" ;
    rdfs:comment """A condition of deep, entrenched ideological, political, or social division
within a community that creates distinct, mutually hostile camps. High polarisation
increases disinformation effectiveness by reducing cross-group information sharing
and increasing in-group echo chamber dynamics. Corresponds to
Topic.polarizationIndex and AudienceSegment.audiencePolarisationIndex.
Maps to DISARM T0074 (Identify Existing Fissures) and T0082 (Identify Wedge Issues).""" ;
    rdfs:subClassOf codion:SocialVulnerability .

codion:PublicHealthEmergency a owl:Class ;
    rdfs:label "Public Health Emergency Vulnerability" ;
    rdfs:comment """Heightened susceptibility during pandemics, outbreaks, or public health crises.
Health emergencies produce high anxiety, rapid information demand that outpaces official
response, distrust of potentially contradictory official guidance, and fertile ground
for conspiracy health narratives.
Corresponds to HealthEmergencyEvent. The COVID-19 infodemic is the canonical example.
Maps to DISARM T0057 (Leverage Conspiracy Theory Narratives) in health contexts.""" ;
    rdfs:subClassOf codion:SituationalVulnerability .

codion:RepetitionEffect a owl:Class ;
    rdfs:label "Repetition Effect (Illusory Truth)" ;
    rdfs:comment """The tendency to believe information is true simply because it has been
encountered repeatedly, independent of its actual veracity. This is the cognitive
basis for the disinformation flooding strategy (T0049). Known as the 'illusory truth
effect' in cognitive psychology. Source: Hasher, Goldstein & Toppino 1977;
Pennycook et al. 2018 (DOI: 10.1037/xge0000465).""" ;
    rdfs:subClassOf codion:CognitiveVulnerability .

codion:SecurityImpact a owl:Class ;
    rdfs:label "Security Impact" ;
    rdfs:comment "Effects on military morale, operational security, civil order, or physical safety of individuals." ;
    rdfs:subClassOf codion:Impact .

codion:SituationalVulnerability a owl:Class ;
    rdfs:label "Situational Vulnerability" ;
    rdfs:comment """Time-bounded contextual conditions that temporarily heighten a community's
susceptibility to disinformation. Unlike cognitive or social vulnerabilities (which
are relatively stable), situational vulnerabilities are event-triggered and time-limited,
corresponding to high-salience Events that adversaries exploit as 'information hooks'.
Maps to DISARM TA08 (Conduct Pump Priming), TA13 (Target Audience Analysis), and
the Event class (Event.eventSalience, Event.emotionalSalienceScore).
Note: SituationalVulnerability instances often co-occur with the corresponding
Event subclass (ElectionPeriod ↔ ElectoralEvent, ArmedConflict ↔ MilitaryConflictEvent).""" ;
    rdfs:subClassOf codion:Vulnerability .

codion:SocialCohesionImpact a owl:Class ;
    rdfs:label "Social Cohesion Impact" ;
    rdfs:comment "Changes in intergroup relations, community solidarity, polarisation levels, or social trust." ;
    rdfs:subClassOf codion:Impact .

codion:SocialGrievance a owl:Class ;
    rdfs:label "Social Grievance" ;
    rdfs:comment """A condition in which a community holds legitimate or perceived grievances
related to historical injustice, economic inequality, political marginalisation,
or cultural suppression. Social grievances are powerful emotional hooks that
disinformation narratives exploit to mobilise anger and resentment.
Maps to DISARM T0003 (Leverage Existing Narratives) and EmotionAnnotation.angerScore.""" ;
    rdfs:subClassOf codion:SocialVulnerability .

codion:SocialVulnerability a owl:Class ;
    rdfs:label "Social Vulnerability" ;
    rdfs:comment """Community-level social fragility conditions that create fertile ground for
disinformation operations. Social vulnerabilities are pre-existing structural
characteristics of a community or society that disinformation exploits and amplifies.
Maps to DISARM TA13 (Target Audience Analysis), T0074 (Identify Existing Fissures),
and the ABCDE Degree dimension (societal receptivity to disinformation spread).""" ;
    rdfs:subClassOf codion:Vulnerability .

codion:TechnicalCountermeasure a owl:Class ;
    rdfs:label "Technical Countermeasure" ;
    rdfs:comment "Platform-level technical interventions: bot detection, content fingerprinting, provenance metadata (C2PA), API access controls." ;
    rdfs:subClassOf codion:Countermeasure .

codion:TechnicalVulnerability a owl:Class ;
    rdfs:label "Technical Vulnerability" ;
    rdfs:comment """Platform, infrastructure, or digital ecosystem weaknesses that enable or
amplify disinformation operations. Technical vulnerabilities may be structural
features of platform design, gaps in moderation capability, or security weaknesses.
Primary source: ENISA Threat Landscape 2024 (infrastructure and platform threats).
Maps to DISARM TA07 (Select Channels and Affordances) and TA15 (Establish Assets).""" ;
    rdfs:subClassOf codion:Vulnerability .

codion:Vulnerability a owl:Class ;
    rdfs:label "Vulnerability" ;
    rdfs:comment """A pre-existing condition or characteristic of an individual, community,
platform, or situational context that increases susceptibility to disinformation
influence. Vulnerability models WHY a particular audience or context is susceptible —
the causal mechanism through which disinformation achieves its Effect — distinct from
AudienceSegment (WHO the audience is) and Impact (WHAT happened as a result).

Four branches:
  CognitiveVulnerability   — individual psychological predispositions (8 leaf classes)
  SocialVulnerability      — community-level social fragility (5 leaf classes)
  TechnicalVulnerability   — platform and infrastructure weaknesses (4 leaf classes)
  SituationalVulnerability — time-bounded contextual amplifiers (5 leaf classes)

Primary sources: Lewandowsky et al. 2017 (DOI:10.1016/j.jarmac.2017.07.008);
Pennycook & Rand 2021 (DOI:10.1016/j.tics.2021.02.007);
DISARM TA13, T0010, T0074, T0080; ENISA ETL 2024; Wardle & Derakhshan 2017.""" ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module D - Consequences and Response (domain entity or relation)" .

codion:WeakPlatformModeration a owl:Class ;
    rdfs:label "Weak Platform Moderation" ;
    rdfs:comment """A platform characteristic where content moderation policies, enforcement
mechanisms, or automated detection systems are insufficient to identify and remove
disinformation at scale. Corresponds to Channel.moderationLevel = NONE or LOW.
Maps to DISARM T0043 (Use Fringe Platform) and T0041 (Use Dark Web Platforms).
Exploited by: inauthentic account networks, bot amplification, coordinated flooding.""" ;
    rdfs:subClassOf codion:TechnicalVulnerability .

codion:campaignDetectedAt a owl:DatatypeProperty ;
    rdfs:label "detected at" ;
    rdfs:domain codion:DetectionEvent ;
    rdfs:range xsd:dateTime .

codion:cognitiveVulnerabilityOCEANCorrelate a owl:DatatypeProperty ;
    rdfs:label "OCEAN personality correlate" ;
    rdfs:comment "Big-Five personality dimension(s) associated with elevated expression of this vulnerability (e.g., ConfirmationBias correlates with high Conscientiousness in partisan contexts)." ;
    rdfs:domain codion:CognitiveVulnerability ;
    rdfs:range xsd:string .

codion:cognitiveVulnerabilityPsychologicalMechanism a owl:DatatypeProperty ;
    rdfs:label "psychological mechanism" ;
    rdfs:comment "Description of the underlying cognitive or psychological mechanism (e.g., heuristic processing, motivated reasoning, dual-process theory)." ;
    rdfs:domain codion:CognitiveVulnerability ;
    rdfs:range xsd:string .

codion:countermeasureActorType a owl:DatatypeProperty ;
    rdfs:label "implementing actor type" ;
    rdfs:comment "Who implements this countermeasure: PLATFORM | GOVERNMENT | CIVIL_SOCIETY | RESEARCHER | INDIVIDUAL | MILITARY | INTERNATIONAL_ORG." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

codion:countermeasureAddressesImpact a owl:ObjectProperty ;
    rdfs:label "addresses impact" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range codion:Impact ;
    owl:inverseOf codion:impactAddressedByCounter .

codion:countermeasureAddressesNarrative a owl:ObjectProperty ;
    rdfs:label "addresses narrative" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range codion:Narrative .

codion:countermeasureAppliedToCampaign a owl:ObjectProperty ;
    rdfs:label "applied to campaign" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range codion:Campaign .

codion:countermeasureAppliedToIncident a owl:ObjectProperty ;
    rdfs:label "applied to incident" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range codion:Incident .

codion:countermeasureComplementedBy a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "complemented by" ;
    rdfs:comment "Two countermeasures are mutually reinforcing when deployed together." ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range codion:Countermeasure .

codion:countermeasureDescription a owl:DatatypeProperty ;
    rdfs:label "countermeasure description" ;
    rdfs:domain codion:Countermeasure ;
    rdfs:range xsd:string .

codion:countermeasureEffectivenessScore a owl:DatatypeProperty ;
    rdfs:label "effectiveness score" ;
