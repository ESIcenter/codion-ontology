    rdfs:range xsd:integer .

codion:urgencyScore a owl:DatatypeProperty ;
    rdfs:label "urgency score" ;
    rdfs:domain codion:RhetoricalAnnotation ;
    rdfs:range xsd:float .

codion:wikidataEventId a owl:DatatypeProperty ;
