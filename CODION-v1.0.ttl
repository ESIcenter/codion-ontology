codion:evidenceSourceUrl a owl:DatatypeProperty ;
    rdfs:label "evidence source URL" ;
    rdfs:domain codion:Evidence ;
    rdfs:range xsd:anyURI .

codion:exploitedByKnownCampaigns a owl:DatatypeProperty ;
