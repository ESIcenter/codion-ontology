@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix codion:  <https://ontology.cogops.eu/codion#> .
@prefix disarm:  <https://ontology.cogops.eu/codion/disarm#> .


# ===========================================================================
#  CODION: Cognitive Operations, Disinformation and Influence Ontology, version 1.0.0
#  OWL 2 / RDF Turtle. Self-contained: no owl:imports.
#  Licence: CC BY 4.0, https://creativecommons.org/licenses/by/4.0/
#
#  Namespaces
#    codion:  https://ontology.cogops.eu/codion#   CODION classes and properties
#    disarm:  https://ontology.cogops.eu/codion/disarm#           DISARM v1.6 alignment
#
#  Sections: annotation properties; Module A Information and Meaning;
#  Module B Actors and Targeting; Module C Operations; Module D Consequences
#  and Response; Module E Evidence, Assessment and Context; DISARM.
# ===========================================================================

<https://ontology.cogops.eu/codion> a owl:Ontology ;
    rdfs:label "CODION"@en ;
    dcterms:creator "George Sharkov",
        "Todor Tagarev" ;
    dcterms:description "CODION (Cognitive Operations, Disinformation and Influence Ontology) is an OWL 2 ontology for knowledge-graph representation of disinformation campaigns, influence operations and cognitive warfare. It is organised in five modules: (A) Information and Meaning, (B) Actors and Targeting, (C) Operations, (D) Consequences and Response, and (E) Evidence, Assessment and Context. It separates persistent domain entities from contextual relations and analytical or evidentiary constructs, and uses qualified relations (ActorParticipation, ActorRelationship, TargetingRelation, Assertion and its specialisations) where relationships carry role, confidence, time or evidence. It is self-contained (no owl:imports) and includes DISARM v1.6 phases, tactics and a representative subset of techniques, sub-techniques and countermeasures as named individuals in the disarm: namespace."@en ;
    dcterms:issued "2026-11-10"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-10"^^xsd:date ;
    dcterms:title "CODION: Cognitive Operations, Disinformation and Influence Ontology"@en ;
    vann:preferredNamespacePrefix "codion" ;
    vann:preferredNamespaceUri "https://ontology.cogops.eu/codion#" ;
    rdfs:seeAlso <https://aiforgood.itu.int/multimedia-authenticity/>,
        <https://docs.oasis-open.org/cti/stix/v2.1/os/stix-v2.1-os.pdf>,
        <https://github.com/DISARMFoundation/DISARMframeworks>,
        <https://www.eeas.europa.eu/eeas/information-integrity-and-countering-foreign-information-manipulation-interference-fimi_en>,
        <https://www.etsi.org/deliver/etsi_tr/104100_104199/104159/01.01.01_60/tr_104159v010101p.pdf> ;
    owl:versionIRI <https://ontology.cogops.eu/codion/1.0.0> ;
    owl:versionInfo "1.0.0" .

# ===========================================================================
#  Annotation properties
# ===========================================================================

codion:alignedDisarmTactic a owl:AnnotationProperty ;
    rdfs:label "aligned DISARM tactic" ;
    rdfs:comment "Links a CODION technique category to the DISARM tactic(s) whose techniques it groups." .

codion:analystAnnotation a owl:AnnotationProperty ;
    rdfs:label "analyst annotation" ;
    rdfs:comment "Free-text annotation added by a human analyst." .

codion:audienceVulnerabilityMappingSource a owl:AnnotationProperty ;
    rdfs:label "audience vulnerability mapping source" ;
    rdfs:comment "Annotation crediting RESIST 3's audience-mapping guidance ('conducting detailed audience mapping that identifies segments vulnerable to mis- and disinformation') as an informing source for the audienceExhibitsVulnerability object property and the AudienceSegment.audienceVulnerabilityScore data property." .

codion:belongsToModule a owl:AnnotationProperty ;
    rdfs:label "belongs to module" ;
    rdfs:comment "The CODION module a class belongs to (A Information and Meaning, B Actors and Targeting, C Operations, D Consequences and Response, E Evidence, Assessment and Context), and whether it is a domain entity or relation or an analytical or evidentiary construct. Subclasses inherit the module of their parent." .

codion:confidenceLevel a owl:AnnotationProperty ;
    rdfs:label "confidence level" ;
    rdfs:comment "Confidence level of the assertion: LOW | MEDIUM | HIGH | CONFIRMED." .

codion:ingestedAt a owl:AnnotationProperty ;
    rdfs:label "ingested at" ;
    rdfs:comment "Timestamp of triple creation in the knowledge graph." .

codion:ingestedFromSource a owl:AnnotationProperty ;
    rdfs:label "ingested from source" ;
    rdfs:comment "URI or system identifier of the ingestion pipeline that created this triple." .

codion:lastUpdatedAt a owl:AnnotationProperty ;
    rdfs:label "last updated at" ;
    rdfs:comment "Date and time at which the record was last updated." .

codion:nistControlId a owl:AnnotationProperty ;
    rdfs:label "NIST control ID" ;
    rdfs:comment "NIST SP 800-53 control identifier (e.g., 'SI-8: Spam Protection') applicable to a disinformation countermeasure." .

codion:nistRMFCategory a owl:AnnotationProperty ;
    rdfs:label "NIST RMF category" ;
    rdfs:comment "NIST Cybersecurity Framework 2.0 function mapping: IDENTIFY | PROTECT | DETECT | RESPOND | RECOVER | GOVERN. Applied to DetectionEvent and Counter instances." .

codion:trustworthyAIRequirement a owl:AnnotationProperty ;
    rdfs:label "Trustworthy AI requirement" ;
    rdfs:comment """Annotation linking a Countermeasure to the ETSI TR 104 159 / EU
Trustworthy AI requirement it supports. Controlled vocabulary: HumanAgencyOversight |
TechnicalRobustnessSafety | PrivacyDataGovernance | Transparency |
DiversityNonDiscriminationFairness | SocietalEnvironmentalWellbeing | Accountability.
Source: ETSI TR 104 159 V1.1.1, clause 8.2 (Lawful / Ethical / Robust pillars mapped to
seven requirements).""" .

# ===========================================================================
#  Root class
# ===========================================================================

codion:CogOpsEntity a owl:Class ;
    rdfs:label "Cognitive Operations Entity" ;
    rdfs:comment "Abstract root class for all entities in the cognitive-operations domain." .

codion:counterAppliesTo a owl:ObjectProperty ;
    rdfs:label "counter applies to" ;
    rdfs:comment "A Blue Team Counter is being applied or recommended against this Campaign." ;
    rdfs:domain disarm:Counter ;
    rdfs:range codion:Campaign .

codion:counterRecommendsForTopic a owl:ObjectProperty ;
    rdfs:label "counter recommends for topic" ;
    rdfs:comment "A DISARM Blue counter-measure is specifically recommended for protecting a given high-risk topic." ;
    rdfs:domain disarm:Counter ;
    rdfs:range codion:Topic .

codion:responseWorkflowStage a owl:DatatypeProperty ;
    rdfs:label "response workflow stage" ;
    rdfs:comment """The defender-side analytical response stage, applied to Countermeasure,
Activity, and Assertion instances representing part of a response cycle. Adopts RESIST 3's
six-stage response process verbatim rather than an invented generic vocabulary:

Recognise            - spot false or misleading messages and how they connect into
                        harmful narratives (uses the FIRST indicator set: Fabrication,
                        Identity, Rhetoric, Symbolism, Technology)
EarlyWarning          - systematic monitoring for emerging information threats
SituationalInsight    - turning monitoring into analytical understanding of who is
                        spreading a narrative and why
ImpactAnalysis        - assessing the severity and audience reach of a threat
StrategicCommunication - the coordinated response itself (in RESIST, typically handed
                        off to the UK Government Communication Service's OASIS
                        campaign-planning framework)
TrackOutcomes         - evaluating whether the response worked and feeding lessons back
                        into the cycle

Kept explicitly distinct from the DISARM adversary kill-chain phases (disarm:Phase:
Plan/Prepare/Execute/Assess), which describe the attacker's operational sequence rather
than the defender's response sequence.

Source: UK Government Communication Service, RESIST 3: Building Resilience to
Information Threats, 2025 (developed by Dr James Pamment, Lund University Psychological
Defence Research Institute); earlier edition RESIST 2 (2021).""" ;
    rdfs:domain codion:CogOpsEntity ;
    rdfs:range xsd:string .

codion:techniqueExploitsVulnerability a owl:ObjectProperty ;
    rdfs:label "technique exploits vulnerability" ;
    rdfs:comment "Links a DISARM technique to a vulnerability type it exploits. The twelve reference mappings shipped with CODION use the vulnerability class IRI as the value (OWL 2 punning), so that a technique can point to a vulnerability type without creating duplicate individuals. Instance data may also link to individual Vulnerability instances." ;
    rdfs:domain disarm:Technique ;
    rdfs:range codion:Vulnerability .

# ===========================================================================
#  Module A - Information and Meaning
# ===========================================================================

codion:Advertisement a owl:Class ;
    rdfs:label "Advertisement" ;
    rdfs:comment "Paid or sponsored content item." ;
    rdfs:subClassOf codion:ContentItem .

codion:Article a owl:Class ;
    rdfs:label "Article" ;
    rdfs:comment "A long-form textual content item published on a news or blog platform." ;
    rdfs:subClassOf codion:ContentItem .

codion:AudioContent a owl:Class ;
    rdfs:label "Audio Content" ;
    rdfs:comment "A podcast episode, radio broadcast clip, or other audio item." ;
    rdfs:subClassOf codion:ContentItem .

codion:BroadcastMedia a owl:Class ;
    rdfs:label "Broadcast Media" ;
    rdfs:comment "Television or radio broadcast channel (state, commercial, or satellite)." ;
    rdfs:subClassOf codion:Channel .

codion:Channel a owl:Class ;
    rdfs:label "Channel" ;
    rdfs:comment "A distribution medium through which ContentItems are published or shared." ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module A - Information and Meaning (domain entity or relation)" .

codion:Claim a owl:Class ;
    rdfs:label "Claim" ;
    rdfs:comment "A specific, assertable statement that can be subjected to fact-checking." ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module A - Information and Meaning (domain entity or relation)" .

codion:Comment a owl:Class ;
    rdfs:label "Comment" ;
    rdfs:comment "A reply or comment attached to another ContentItem." ;
    rdfs:subClassOf codion:ContentItem .

codion:ContentItem a owl:Class ;
    rdfs:label "Content Item" ;
    rdfs:comment """Any discrete piece of content ingested from a media channel:
articles, posts, videos, memes, documents, comments, etc.""" ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module A - Information and Meaning (domain entity or relation)" .

codion:DarkWebChannel a owl:Class ;
    rdfs:label "Dark Web Channel" ;
    rdfs:comment "A channel accessible only via anonymising networks (Tor, I2P)." ;
    rdfs:subClassOf codion:Channel .

codion:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:comment "A PDF, Word document, or other formal document." ;
    rdfs:subClassOf codion:ContentItem .

codion:EmailList a owl:Class ;
    rdfs:label "Email List" ;
    rdfs:comment "An email newsletter list or mailing list." ;
    rdfs:subClassOf codion:Channel .

codion:Forum a owl:Class ;
    rdfs:label "Forum" ;
    rdfs:comment "An online forum or imageboard (Reddit, 4chan, etc.)." ;
    rdfs:subClassOf codion:Channel .

codion:ForumPost a owl:Class ;
    rdfs:label "Forum Post" ;
    rdfs:comment "A message published in an online forum or message board." ;
    rdfs:subClassOf codion:ContentItem .

codion:ImageContent a owl:Class ;
    rdfs:label "Image Content" ;
    rdfs:comment "A standalone image (photograph, infographic, screenshot)." ;
    rdfs:subClassOf codion:ContentItem .

codion:LiveStreamChannel a owl:Class ;
    rdfs:label "Live Stream Channel" ;
    rdfs:comment "A live video streaming platform or channel (Twitch, YouTube Live, Periscope)." ;
    rdfs:subClassOf codion:Channel .

codion:Meme a owl:Class ;
    rdfs:label "Meme" ;
    rdfs:comment "An image or short video with embedded text designed for viral spread." ;
    rdfs:subClassOf codion:ContentItem .

codion:MessengerPlatform a owl:Class ;
    rdfs:label "Messenger Platform" ;
    rdfs:comment "An encrypted or semi-open messaging platform (Telegram, WhatsApp, Signal)." ;
    rdfs:subClassOf codion:Channel .

codion:Narrative a owl:Class ;
    rdfs:label "Narrative" ;
    rdfs:comment """A coherent line of messaging — a story, frame, or recurring theme —
propagated across multiple ContentItems. May mutate over time.""" ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module A - Information and Meaning (domain entity or relation)" .

codion:NewsWebsite a owl:Class ;
    rdfs:label "News Website" ;
    rdfs:comment "An online news or blog publication." ;
    rdfs:subClassOf codion:Channel .

codion:NewsletterIssue a owl:Class ;
    rdfs:label "Newsletter Issue" ;
    rdfs:comment "A single issue of an email newsletter or Substack-style publication." ;
    rdfs:subClassOf codion:ContentItem .

codion:P2PNetwork a owl:Class ;
    rdfs:label "Peer-to-Peer Network" ;
    rdfs:comment "Peer-to-peer sharing network with no central platform (BitTorrent, IPFS-based)." ;
    rdfs:subClassOf codion:Channel .

codion:PodcastPlatform a owl:Class ;
    rdfs:label "Podcast Platform" ;
    rdfs:comment "A podcast distribution platform or RSS feed." ;
    rdfs:subClassOf codion:Channel .

codion:PressRelease a owl:Class ;
    rdfs:label "Press Release" ;
    rdfs:comment "An official press release issued by an organisation." ;
    rdfs:subClassOf codion:ContentItem .

codion:PrintMedia a owl:Class ;
    rdfs:label "Print Media" ;
    rdfs:comment "Newspaper, magazine, or print publication (physical or digital edition)." ;
    rdfs:subClassOf codion:Channel .

codion:SocialPlatform a owl:Class ;
    rdfs:label "Social Platform" ;
    rdfs:comment "A social-networking platform (Twitter/X, Facebook, VKontakte, etc.)." ;
    rdfs:subClassOf codion:Channel .

codion:SocialPost a owl:Class ;
    rdfs:label "Social Post" ;
    rdfs:comment "A short-form post published on a social-media platform (tweet, Facebook post, etc.)." ;
    rdfs:subClassOf codion:ContentItem .

codion:Topic a owl:Class ;
    rdfs:label "Topic" ;
    rdfs:comment "A subject domain or theme addressed by ContentItems or Narratives." ;
    rdfs:subClassOf codion:CogOpsEntity ;
    codion:belongsToModule "Module A - Information and Meaning (domain entity or relation)" .

codion:VideoContent a owl:Class ;
    rdfs:label "Video Content" ;
    rdfs:comment "A video or live-stream item." ;
    rdfs:subClassOf codion:ContentItem .

codion:VideoPlatform a owl:Class ;
    rdfs:label "Video Platform" ;
    rdfs:comment "A video hosting or live-streaming platform (YouTube, Rumble, etc.)." ;
    rdfs:subClassOf codion:Channel .

codion:algorithmicAmplification a owl:DatatypeProperty ;
    rdfs:label "algorithmic amplification" ;
    rdfs:comment "True if the platform uses algorithmic feed curation." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:boolean .

codion:allowedContentTypes a owl:DatatypeProperty ;
    rdfs:label "allowed content types" ;
    rdfs:comment "Semicolon-separated list of content types permitted: TEXT | IMAGE | VIDEO | AUDIO | DOCUMENT | LIVE." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:string .

codion:amplifiedBy a owl:ObjectProperty ;
    rdfs:label "amplified by" ;
    rdfs:comment "An Actor who reshared or boosted this ContentItem." ;
    rdfs:domain codion:ContentItem ;
    rdfs:range codion:Actor .

codion:amplifies a owl:ObjectProperty ;
    rdfs:label "amplifies" ;
    rdfs:comment "This item boosts the reach or credibility of another ContentItem." ;
    rdfs:domain codion:ContentItem ;
    rdfs:range codion:ContentItem .

codion:apiAccessible a owl:DatatypeProperty ;
    rdfs:label "API accessible" ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:boolean .

codion:attributedToCampaign a owl:ObjectProperty ;
    rdfs:label "attributed to campaign" ;
    rdfs:domain codion:ContentItem ;
    rdfs:range codion:Campaign .

codion:channelAveragePostLifespanHours a owl:DatatypeProperty ;
    rdfs:label "average post lifespan (hours)" ;
    rdfs:comment "Estimated time before content becomes invisible in normal feed (relevant for ephemeral platforms)." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:float .

codion:channelCompetingWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "competing with" ;
    rdfs:comment "Two channels compete for the same audience segment — relevant for narrative seeding strategy analysis." ;
    rdfs:domain codion:Channel ;
    rdfs:range codion:Channel ;
    rdfs:subPropertyOf owl:topObjectProperty .

codion:channelExhibitsTechnicalVulnerability a owl:ObjectProperty ;
    rdfs:label "channel exhibits technical vulnerability" ;
    rdfs:comment "A Channel exhibits a TechnicalVulnerability. For example: a fringe social platform exhibits WeakPlatformModeration; a mainstream platform exhibits AlgorithmicAmplification." ;
    rdfs:domain codion:Channel ;
    rdfs:range codion:TechnicalVulnerability .

codion:channelFoundedDate a owl:DatatypeProperty ;
    rdfs:label "channel founded date" ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:date .

codion:channelHandle a owl:DatatypeProperty ;
    rdfs:label "channel handle" ;
    rdfs:comment "Platform-specific handle or username (e.g., @channel_name)." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:string .

codion:channelHasRecommendationAlgorithm a owl:DatatypeProperty ;
    rdfs:label "has recommendation algorithm" ;
    rdfs:comment "True if the platform uses algorithmic content recommendation (relevant for amplification potential)." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:boolean .

codion:channelId a owl:DatatypeProperty ;
    rdfs:label "channel ID" ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:string .

codion:channelIsEphemeral a owl:DatatypeProperty ;
    rdfs:label "is ephemeral" ;
    rdfs:comment "True if content disappears after a fixed period (Stories, Snapchat, etc.)." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:boolean .

codion:channelIsPreferredByThreatActor a owl:DatatypeProperty ;
    rdfs:label "preferred by known threat actor" ;
    rdfs:comment "Analyst flag: true if this channel type is a known preference of attributed threat actors." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:boolean .

codion:channelNativeName a owl:DatatypeProperty ;
    rdfs:label "channel native name" ;
    rdfs:comment "The channel's name in its primary operating language." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:string .

codion:channelOpenToExternalLinks a owl:DatatypeProperty ;
    rdfs:label "open to external links" ;
    rdfs:comment "True if users can post hyperlinks to external sites." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:boolean .

codion:channelPlatformId a owl:DatatypeProperty ;
    rdfs:label "platform ID" ;
    rdfs:comment "Platform-native numeric or alphanumeric identifier." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:string .

codion:channelReachGeographyIds a owl:DatatypeProperty ;
    rdfs:label "reach geography IDs" ;
    rdfs:comment "Semicolon-separated ISO 3166-1 codes of countries where this channel has significant reach." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:string .

codion:channelReachesLocation a owl:ObjectProperty ;
    rdfs:label "channel reaches location" ;
    rdfs:comment "Geographic market where this channel has significant audience penetration." ;
    rdfs:domain codion:Channel ;
    rdfs:range codion:Location .

codion:channelServesPrimaryLanguage a owl:ObjectProperty ;
    rdfs:label "channel serves linguistic audience" ;
    rdfs:comment "The primary linguistic audience segment this channel serves." ;
    rdfs:domain codion:Channel ;
    rdfs:range codion:AudienceSegment .

codion:channelSupportsCrossPosting a owl:DatatypeProperty ;
    rdfs:label "supports cross-posting" ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:boolean .

codion:channelType a owl:DatatypeProperty ;
    rdfs:label "channel type" ;
    rdfs:comment "Controlled vocabulary: SOCIAL_NETWORK | FORUM | MESSENGER | NEWS_SITE | VIDEO_PLATFORM | PODCAST | DARKWEB | EMAIL_LIST." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:string .

codion:channelUrl a owl:DatatypeProperty ;
    rdfs:label "channel URL" ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:anyURI .

codion:channelVerificationBadgeAvailable a owl:DatatypeProperty ;
    rdfs:label "verification badge available" ;
    rdfs:comment "True if the platform offers verified account badges that can be abused via impersonation." ;
    rdfs:domain codion:Channel ;
    rdfs:range xsd:boolean .

codion:characterCount a owl:DatatypeProperty ;
    rdfs:label "character count" ;
    rdfs:domain codion:ContentItem ;
    rdfs:range xsd:integer .

codion:claimCheckworthyScore a owl:DatatypeProperty ;
    rdfs:label "checkworthy score" ;
    rdfs:comment "Automated checkworthiness score [0,1] indicating priority for fact-checking resource allocation." ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:float .

codion:claimContradictsClaim a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "claim contradicts claim" ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:Claim .

codion:claimCounteredByCountermeasure a owl:ObjectProperty ;
    rdfs:label "claim countered by" ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:Countermeasure .

codion:claimEmotionalCharging a owl:DatatypeProperty ;
    rdfs:label "emotional charging" ;
    rdfs:comment "Degree [0,1] to which the claim is framed in emotionally charged language (independent of polarity)." ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:float .

codion:claimExhibitsTechnique a owl:ObjectProperty ;
    rdfs:label "claim exhibits technique" ;
    rdfs:comment "The DISARM technique most closely corresponding to how this claim is constructed (e.g., T0023 Distort Facts, T0029 Seed Kernel of Truth, T0025 Leak Altered Documents)." ;
    rdfs:domain codion:Claim ;
    rdfs:range disarm:Technique .

codion:claimFirstAppearanceUrl a owl:DatatypeProperty ;
    rdfs:label "first appearance URL" ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:anyURI .

codion:claimFirstSeenAt a owl:DatatypeProperty ;
    rdfs:label "first seen at" ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:dateTime .

codion:claimGeographicScope a owl:ObjectProperty ;
    rdfs:label "claim geographic scope" ;
    rdfs:comment "The geographic region to which this claim primarily pertains." ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:Location .

codion:claimHarmSeverity a owl:DatatypeProperty ;
    rdfs:label "claim harm severity" ;
    rdfs:comment "Controlled vocabulary: LOW | MEDIUM | HIGH | CRITICAL." ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:string .

codion:claimHarmType a owl:DatatypeProperty ;
    rdfs:label "claim harm type" ;
    rdfs:comment "Controlled vocabulary (AMAS-aligned): HEALTH_HARM | ELECTORAL_HARM | SECURITY_HARM | FINANCIAL_HARM | REPUTATIONAL_HARM | SOCIAL_COHESION_HARM | INSTITUTIONAL_HARM | NONE." ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:string .

codion:claimId a owl:DatatypeProperty ;
    rdfs:label "claim ID" ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:string .

codion:claimKeywords a owl:DatatypeProperty ;
    rdfs:label "claim keywords" ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:string .

codion:claimLanguage a owl:DatatypeProperty ;
    rdfs:label "claim language" ;
    rdfs:comment "BCP-47 language tag of the canonical claim text." ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:string .

codion:claimMadeIn a owl:ObjectProperty ;
    rdfs:label "claim made in" ;
    rdfs:comment "Inverse of makesClaim: this claim appears in the referenced ContentItem." ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:ContentItem ;
    owl:inverseOf codion:makesClaim .

codion:claimMutationOf a owl:ObjectProperty ;
    rdfs:label "claim mutation of" ;
    rdfs:comment "This claim is a modified variant of the referenced original claim." ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:Claim .

codion:claimPartOfNarrative a owl:ObjectProperty ;
    rdfs:label "claim part of narrative" ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:Narrative .

codion:claimPseudoscientificContent a owl:DatatypeProperty ;
    rdfs:label "pseudoscientific content" ;
    rdfs:comment "True if the claim invokes pseudoscientific or false-expert framing." ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:boolean .

codion:claimReferencesEvent a owl:ObjectProperty ;
    rdfs:label "claim references event" ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:Event .

codion:claimSupportsClaim a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "claim supports claim" ;
    rdfs:comment "Two claims mutually reinforce each other within a narrative framework." ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:Claim .

codion:claimTargetsActor a owl:ObjectProperty ;
    rdfs:label "claim targets actor" ;
    rdfs:comment "The Actor (individual or organisation) about whom or against whom this claim is made." ;
    rdfs:domain codion:Claim ;
    rdfs:range codion:Actor .

codion:claimText a owl:DatatypeProperty ;
    rdfs:label "claim text" ;
    rdfs:domain codion:Claim ;
    rdfs:range xsd:string .

